+// commitNoReplace 优先硬链接提交（no-replace）；环境不允许硬链接时（如 Android/Termux 的 SELinux）
+// 退化为「预检查 + rename」，保持不覆盖已有对象的语义。
+func commitNoReplace(src, dst string) error {
+	linkErr := os.Link(src, dst)
+	if linkErr == nil {
+		return nil
+	}
+	if _, statErr := os.Stat(dst); statErr == nil {
+		return fmt.Errorf("目标已存在（且硬链接不可用: %v）", linkErr)
+	} else if !errors.Is(statErr, os.ErrNotExist) {
+		return statErr
+	}
+	if renameErr := os.Rename(src, dst); renameErr != nil {
+		return fmt.Errorf("%w（硬链接回退失败: %v）", renameErr, linkErr)
+	}
+	return nil
+}
